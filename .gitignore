node_modules/
dist/
coverage/
.vitest-reports/
.env
.artifacts/
.DS_Store
*.log
.idea/
# the types `agboss check` generates (#272): never committed, regenerated by check:types
.agboss/
# the project skills `agboss check` syncs into a project (#305, #983): the examples get theirs on every
# check — the copy in .agents/skills/agboss/ (committed in a real project, not duplicated per example here)
# and the local link to it (no trailing slash: git does not take a link for a folder)
**/.claude/skills/agboss
examples/**/.agents/skills/agboss/
**/.agents/.agboss-skills-*

# LangGraph API
.langgraph_api
packages/*/dist
packages/*/.scaffold-tmp
examples/.scaffold-tmp-*
*.tgz

# #533: Stryker mutation runs (reports/ — the incremental file is CI-cached, never committed)
packages/agboss/reports/
packages/agboss/.stryker-tmp*/
.a2a-tck/
