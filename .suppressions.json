{
  "src @ts-ignore": 2,
  "src as unknown as": 4,
  "src eslint:@typescript-eslint/ban-ts-comment": 2,
  "src eslint:@typescript-eslint/explicit-module-boundary-types": 1,
  "src eslint:@typescript-eslint/no-base-to-string": 1,
  "src eslint:@typescript-eslint/no-explicit-any": 5,
  "src eslint:@typescript-eslint/no-unsafe-argument": 1,
  "src eslint:@typescript-eslint/no-unsafe-assignment": 1,
  "src eslint:@typescript-eslint/unbound-method": 1,
  "src eslint:max-lines-per-function": 1,
  "tests @ts-ignore": 1,
  "tests as any": 4,
  "tests eslint:@typescript-eslint/ban-ts-comment": 1,
  "tests eslint:@typescript-eslint/only-throw-error": 1
}
