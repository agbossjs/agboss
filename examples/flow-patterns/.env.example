# Copy to ../../.env (the repo root) for a real run (README → Real runs). Never read by the tests:
# `testWith` has fixed test keys of its own, and the storage's file is `:memory:` there.

# Models through OpenRouter (the `dev` profile)
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# The application's keys (`src/storage/`, @DatabaseStorage): each its own variable, the same on every
# instance; any long random text for a local run. `agboss check` does not read them.
# The HMAC key of Idempotency's business-key fingerprints (the credit desk's charge, #825)
AGBOSS_IDEMPOTENCY_SECRET=
# The PII key: one token per value on every instance (#120)
PII_PSEUDONYM_KEY=

# Where the SQLite stores live; default .agboss/flow-patterns.sqlite (the desk: .agboss/desk-offline.sqlite)
# AGBOSS_SQLITE_PATH=
