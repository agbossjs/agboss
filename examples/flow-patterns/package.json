{
  "name": "flow-patterns-example",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AGBoss example: flow patterns — a review loop, a code router, parallel launches, a quorum, child workflows and recursion, scripted tests only",
  "agboss": {
    "application": "src/flow-patterns.application.ts"
  },
  "scripts": {
    "describe": "agboss describe",
    "types": "agboss check",
    "check": "agboss check --strict",
    "typecheck": "npm run types && tsc --noEmit -p .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "agboss": "0.1.0"
  },
  "devDependencies": {
    "agboss-cli": "0.1.0"
  }
}
