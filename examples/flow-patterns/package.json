{
  "name": "flow-patterns-example",
  "license": "Apache-2.0",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AGBoss example: flow patterns — a review loop, a code router, parallel launches, a quorum, child workflows, recursion and two approvals at once; scripted tests, real runs with OPENROUTER_API_KEY",
  "agboss": {
    "application": "src/flow-patterns.application.ts"
  },
  "scripts": {
    "describe": "agboss describe",
    "types": "agboss check",
    "answer": "tsx src/scripts/answer-pauses.ts",
    "check": "agboss check --strict && agboss check --models --env test",
    "typecheck": "npm run types && tsc --noEmit -p .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "agboss": "0.1.0"
  },
  "devDependencies": {
    "agboss-cli": "0.1.0"
  }
}
