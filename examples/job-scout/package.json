{
  "name": "job-scout-example",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AGBoss example: resume → search brief → Greenhouse jobs ranked by Jev",
  "scripts": {
    "chat": "agboss chat --workflow src/job-scout.workflow.ts",
    "run": "agboss run --workflow src/job-scout.workflow.ts",
    "describe": "agboss describe --workflow src/job-scout.workflow.ts",
    "check:models": "agboss check --models --workflow src/job-scout.workflow.ts --env test",
    "eval": "agboss eval --workflow src/job-scout.workflow.ts",
    "replay": "agboss replay --workflow src/job-scout.workflow.ts",
    "golden": "agboss golden --workflow src/job-scout.workflow.ts",
    "compare": "agboss compare --workflow src/job-scout.workflow.ts",
    "rag:index": "agboss rag:index --workflow src/job-scout.workflow.ts",
    "probe": "tsx src/scripts/probe-boards.ts",
    "types": "agboss check --workflow src/job-scout.workflow.ts",
    "typecheck": "npm run types && tsc --noEmit -p .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "agboss": "0.1.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5",
    "dotenv": "^18.0.3",
    "@modelcontextprotocol/server-filesystem": "^2026.8.31"
  },
  "devDependencies": {
    "agboss-cli": "0.1.0"
  }
}
