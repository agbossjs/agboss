// Unused files and dependencies fail `npm run check` (#205 AC2). Every ignore says why.
{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Unused exports are not checked: the framework's modules export to each other and to their tests
  // by design, and its public surface is guarded by the api-extractor reports (#195, check:api).
  "rules": {
    "exports": "off",
    "types": "off",
    "nsExports": "off",
    "nsTypes": "off",
    "duplicates": "off",
    "enumMembers": "off",
  },
  // `diff` is the system tool scripts/api-report.mjs shows a stale report with, not a package
  "ignoreBinaries": ["diff"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{mjs,cjs}", "eslint.tests.js"],
    },
    "packages/agboss": {
      // the entries of package.json#exports (as sources) and the `schema` script
      "entry": [
        "src/index.ts",
        "src/internal.ts",
        "src/{dto,units,models,testing,mcp,rag,a2a,memory,eval,eslint}/index.ts",
        "src/testing/contracts/index.ts",
        "src/testing/vitest.ts",
        "src/{core,graph,router,tool,channels}/index.ts",
        // loaded by path: `--application <file>` (#268) and the environment of `--env <name>`
        "tests/fixtures/loader/**/*.{workflow,application}.ts",
        // loaded by path: the applications `workflowOf` finds next to a workflow (#497)
        "tests/fixtures/outside-graph/**/*.application.ts",
        "tests/**/fixtures/**/*.environment.ts",
        // loaded by path: the workflows `check:types` generates types for (#272)
        "tests/flow/fixtures/*.fixture.ts",
        // loaded by path: the eval suites `agboss eval run` and `agboss check` find (#396)
        "tests/**/eval-suites/*.eval-suite.ts",
        // loaded by path: the applications `agboss check --federation` is tested on (#398 PR 4)
        "tests/federation/fixtures/*.application.ts",
        // loaded by path: the contract fixtures a nested vitest runs (#481)
        "tests/fixtures/contracts/*.contract-fixture.ts",
        // compile-time tests: checked by tsc (the gate's typecheck), not run by Vitest (#272)
        "tests/**/*.test-d.ts",
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      "ignoreDependencies": [
        // an optional peer: only agboss/testing imports it, in a user's own test run
        "vitest",
        // an optional peer: only agboss/eslint imports it, in a project's ESLint config (#388)
        "@typescript-eslint/utils",
        // the tests start it as an MCP server process (resolved by path, never imported)
        "@modelcontextprotocol/server-filesystem",
        // @langfuse/otel peerDependency: pinned to OpenTelemetry SDK 2.x (<0.300.0) so fresh
        // npm installs do not pull OTel 3.0.0 (0.300.0) against @opentelemetry/api 1.9.x
        "@opentelemetry/otlp-exporter-base",
      ],
    },
    "packages/agboss-cli": {
      // the fixtures are loaded by path (`--application <file>`, #268), with their environments
      "entry": [
        "src/cli/main.ts",
        "tests/fixtures/**/*.workflow.ts",
        "tests/fixtures/**/*.application.ts",
        "tests/fixtures/**/*.environment.ts",
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      // the version a generated project depends on (src/scaffold/project.ts), run by the e2e tests
      "ignoreDependencies": ["@modelcontextprotocol/server-filesystem"],
    },
    "examples/flow-patterns": {
      // the applications, loaded by path (package.json → "agboss": { "application" }, #268, and the
      // offline desk's `--application`, #419), their workflows, the environments of `--env`, the
      // eval suites `agboss eval run` finds by folder (#396) and `npm run answer` (#346)
      "entry": [
        "src/flow-patterns.application.ts",
        "src/desk.application.ts",
        "src/**/*.workflow.ts",
        "src/environments/*.environment.ts",
        "src/**/eval-suites/*.eval-suite.ts",
        "src/scripts/*.ts",
      ],
      "project": ["src/**/*.ts", "tests/**/*.ts"],
      // the policy-files MCP server process, started by path (src/helpline/mcp/), never imported
      "ignoreDependencies": ["@modelcontextprotocol/server-filesystem"],
    },
  },
}
