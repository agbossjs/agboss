{
  "name": "agboss-monorepo",
  "version": "0.1.0",
  "description": "The AGBoss monorepo: the agboss framework, the agboss CLI and their examples. Spring-style TypeScript framework for complex LangGraph AI agents — @Application DI, Path Scope Flow DSL, transactional sagas, FinOps budgets, MCP/RAG/A2A, and deterministic unit testing.",
  "keywords": [
    "agboss",
    "langgraph",
    "langchain",
    "ai-agents",
    "agent-framework",
    "multi-agent",
    "typescript",
    "dependency-injection",
    "workflow",
    "saga",
    "mcp",
    "model-context-protocol",
    "rag",
    "a2a",
    "finops",
    "llm",
    "llm-evaluation",
    "guardrails",
    "pii",
    "nodejs"
  ],
  "homepage": "https://agboss.dev",
  "bugs": {
    "url": "https://github.com/agbossjs/agboss/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agbossjs/agboss.git"
  },
  "license": "Apache-2.0",
  "author": "Pavel Ravvich <hello@agboss.dev> (https://github.com/pavelravvich)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @agboss/core -w @agboss/cli",
    "dev": "npm run dev -w @agboss/core",
    "lint": "eslint .",
    "format": "prettier --write . && node scripts/format-flows.mjs",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "coverage": "npm run coverage --workspaces",
    "check": "npm run check:root && npm run check:suppressions && npm run check:types && npm run build && npm run types -w job-scout-example && npm run check -w flow-patterns-example && npm run check:api && npm run check:docs && npm run format:check && npm run lint && npm run check:knip && npm run typecheck && npm run coverage && npm run check:models",
    "smoke": "npm run smoke -w @agboss/core",
    "studio": "npm run build && npm run studio -w job-scout-example",
    "check:models": "npm run check:models -w job-scout-example",
    "check:suppressions": "node scripts/check-suppressions.mjs",
    "check:knip": "knip",
    "check:root": "node scripts/check-root.mjs",
    "check:types": "node scripts/check-types.mjs",
    "check:api": "node scripts/api-report.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "api:update": "node scripts/api-report.mjs --write"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@microsoft/api-extractor": "^7.59.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "knip": "~6.38.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
