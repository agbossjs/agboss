{
  "name": "@agboss/cli",
  "version": "0.1.0",
  "description": "Official CLI for the AGBoss TypeScript AI agent framework — project scaffolding (agboss create), code generators, static graph & saga verification (agboss check), describe --json, chat, and eval.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "Pavel Ravvich <hello@agboss.dev> (https://github.com/pavelravvich)",
  "homepage": "https://agboss.dev/cli/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agbossjs/agboss.git",
    "directory": "packages/agboss-cli"
  },
  "bugs": {
    "url": "https://github.com/agbossjs/agboss/issues"
  },
  "keywords": [
    "agboss",
    "agboss-cli",
    "cli",
    "langgraph",
    "ai-agents",
    "agent-framework",
    "multi-agent",
    "typescript",
    "scaffolding",
    "codegen",
    "mcp",
    "rag",
    "openapi",
    "llm-evaluation"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "agboss": "./bin/agboss.js",
    "agboss-cli": "./bin/agboss.js"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@agboss/core": "0.1.0",
    "@apidevtools/swagger-parser": "^13.1.0",
    "@inquirer/prompts": "^8.7.2",
    "@langchain/langgraph-cli": "^1.0.0",
    "dotenv": "^18.0.3",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "openapi-types": "^12.1.3"
  }
}
