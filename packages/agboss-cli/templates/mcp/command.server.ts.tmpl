import { NoInputDto, PlainTextDto } from "@agboss/core/dto";
import { McpServer, McpServerClient } from "@agboss/core/mcp";

/** The server tools this workflow uses — checked against the server at startup. */
const tools = {
  "{{serverTool}}": { input: NoInputDto, output: PlainTextDto },
};

/** An MCP server started with `{{command}}` (env: variable NAMES in `env`, never secrets). */
@McpServer({
  name: "{{kebab}}",
  transport: "stdio",
  command: "{{command}}",
  tools,
})
export class {{pascal}}Server extends McpServerClient<typeof tools> {}
