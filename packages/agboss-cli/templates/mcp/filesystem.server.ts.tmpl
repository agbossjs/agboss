import { createRequire } from "node:module";
import { dirname, join } from "node:path";
import { McpServer, McpServerClient } from "@agboss/core/mcp";
import { FileContentDto } from "../dto/file-content.dto.js";
import { FileReadDto } from "../dto/file-read.dto.js";

/** The official filesystem MCP server (a dependency of this project). */
const FILESYSTEM_SERVER = join(
  dirname(createRequire(import.meta.url).resolve("@modelcontextprotocol/server-filesystem/package.json")),
  "dist",
  "index.js",
);

/** The server tools this workflow uses — checked against the server at startup. */
const tools = {
  read_text_file: { input: FileReadDto, output: FileContentDto },
};

/** Files in {{dir}}, through the filesystem MCP server. */
@McpServer({
  name: "{{kebab}}",
  transport: "stdio",
  command: process.execPath,
  args: [FILESYSTEM_SERVER, "{{dir}}"],
  tools,
})
export class {{pascal}}Server extends McpServerClient<typeof tools> {}
