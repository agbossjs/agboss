import { Injectable, type InferEnv } from "@agboss/core";
import { appEnv } from "../config/app.env.js";

/**
 * The API this workflow's tools call. Its address comes from `appEnv` (`../config/app.env.ts`): the
 * variable `API_URL`, or what the selected profile sets (`config/test.config.ts` in tests) — read
 * through `deps: [appEnv]`.
 */
@Injectable({ deps: [appEnv] })
export class ApiService {
  constructor(private readonly config: InferEnv<typeof appEnv>) {}

  /** The full URL of `path` on the API. */
  url(path: string): string {
    return new URL(path, this.config.apiUrl).href;
  }
}
