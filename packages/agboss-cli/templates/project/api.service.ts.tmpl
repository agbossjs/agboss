import { ENV, Injectable } from "agboss";
import type { AppEnvironment } from "../environments/app.environment.js";

/**
 * The API this workflow's tools call. Its address comes from the application's environment —
 * `environments/<name>.environment.ts` next to the application file (`dev` unless `--env` names
 * another, `test` in tests).
 */
@Injectable({ deps: [ENV] })
export class ApiService {
  constructor(private readonly environment: AppEnvironment) {}

  /** The full URL of `path` on the environment's API. */
  url(path: string): string {
    return new URL(path, this.environment.apiUrl).href;
  }
}
