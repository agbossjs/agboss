import { ENV, Injectable, type Environment } from "agboss";

/**
 * The API this workflow's tools call. Its address comes from the app's environment —
 * `environments/<name>.environment.ts` next to the application file (`dev` unless `--env` names another).
 */
@Injectable({ deps: [ENV] })
export class ApiService {
  constructor(private readonly env: Environment) {}

  /** The full URL of `path` on the environment's API. */
  url(path: string): string {
    return new URL(path, this.env.apiUrl).href;
  }
}
