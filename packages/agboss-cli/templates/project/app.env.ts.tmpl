import { defineEnv, env } from "@agboss/core";

/**
 * The process variables the application reads, declared once: each is an `env(…)` / `secret(…)`
 * reference, resolved when the application starts. A component reads the values with
 * `deps: [appEnv]` (`../services/api.service.ts` does), and a component option takes a reference
 * (`appEnv.apiUrl`) where it takes a plain value. The `test` profile gives them the values tests
 * run on (`config/test.config.ts`).
 */
export const appEnv = defineEnv({
  apiUrl: env("API_URL", { default: "https://api.example.com" }),
});
