import type { Secret } from "@agboss/core";

/**
 * The application's environment contract: the fields every `<name>.environment.ts` next to it
 * defines — declared fields only, no values (a default is `env("X", { default })` in an
 * environment, an optional value `env.optional("X")`; a secret is a `Secret` field set with
 * `secret("X")`). Declared once:
 * `@Application({ environment: AppEnvironment })`. Read it as `applicationContext.environment`
 * (`@Injectable({ deps: [ApplicationContext] })`), as `../services/api.service.ts` does.
 */
export class AppEnvironment {
  apiUrl!: string;
  /** OpenRouter's key, read by the model providers (`apiKey: "openRouterApiKey"`); tests script models. */
  openRouterApiKey?: Secret;
  /** OpenRouter's base URL (`baseUrlField: "openRouterBaseUrl"`); unset → the provider's default. */
  openRouterBaseUrl?: string;
}
