import { defineConfig } from "vitest/config";
import { agbossTest } from "@agboss/core/testing/vitest";

/**
 * Three kinds of tests, by file name: unit (`*.test.ts`, no models), integration
 * (`*.integration.test.ts`, recorded answers) and suites (`*.suite.test.ts`, real models).
 * `agbossTest()` loads AGBoss through vite, in the tests' module graph (the files it loads by path
 * — the application, its environments — with their decorators), and registers the workflow
 * matchers: toFollowPath, toFinishWith, toHavePausedAt, …
 */
export default defineConfig({
  test: agbossTest({
    passWithNoTests: true,
    projects: [
      {
        extends: true,
        test: {
          name: "unit",
          include: ["tests/**/*.test.ts"],
          exclude: ["tests/**/*.integration.test.ts", "tests/**/*.suite.test.ts"],
        },
      },
      { extends: true, test: { name: "integration", include: ["tests/**/*.integration.test.ts"] } },
      { extends: true, test: { name: "suites", include: ["tests/**/*.suite.test.ts"] } },
    ],
  }),
});
