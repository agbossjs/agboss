import { join } from "node:path";
import { Rag, SqliteFtsConnector } from "@agboss/core/rag";

/** Full-text search (SQLite FTS5, BM25) over {{folder}}/ — swap for your own RagConnector any time. */
@Rag({ name: "{{kebab}}-rag", description: "{{title}} — the notes in {{folder}}/", topK: 3 })
export class {{pascal}}Rag extends SqliteFtsConnector {
  constructor() {
    super({
      folder: join(process.cwd(), "{{folder}}"),
      // the index lives in the project's git-ignored .agboss/ (`npx agboss rag index` builds it)
      dbFile: join(process.cwd(), ".agboss", "rag", "{{kebab}}-rag.sqlite"),
    });
  }
}
