import { testWith } from "agboss/testing";
import { expect } from "vitest";
import { {{application}} } from "{{applicationFrom}}";
import { {{pascal}}Tool } from "./{{kebab}}.tool.js";

// the tool as the app builds it: its ApiService gets the test environment next to the application file
const test = testWith({{application}});

test("{{kebab}}-tool answers a query on the environment's API", async ({ app }) => {
  const result = await app.tool({{pascal}}Tool).invoke({ query: "example" });

  expect(result.kind).toBe("ok");
  expect(result.kind === "ok" ? result.value.result : result.message).toContain(
    "https://api.test.example.com/{{kebab}}",
  );
});
