import { testWith } from "@agboss/core/testing";
import { expect } from "vitest";
import { {{application}} } from "{{applicationFrom}}";
import { {{pascal}}Tool } from "./{{kebab}}.tool.js";

// the tool as the app builds it: its ApiService gets the `test` profile's values (`config/test.config.ts`)
const test = testWith({{application}});

test("{{kebab}}-tool answers a query on the test profile's API", async ({ app }) => {
  const { output } = await app.runTool({{pascal}}Tool, { query: "example" });

  expect(output.kind).toBe("ok");
  expect(output.kind === "ok" ? output.value.result : output.message).toContain(
    "https://api.test.example.com/{{kebab}}",
  );
});
