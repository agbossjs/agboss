import {
  CachedPart,
  CacheRetention,
  EnvironmentVariable,
  ModelCost,
  ModelProvider,
  OpenRouterProvider,
  PromptCaching,
  Reasoning,
  RetryPolicy,
  TRANSIENT_FAILURES,
  type OpenRouterFields,
} from "agboss/models";
import { minutes, seconds } from "agboss/units";

/**
 * Where the application's chat models come from: OpenRouter (decision models through
 * `DecisionsModelProvider`) — both listed in `@Application({ providers })`.
 */
@ModelProvider({
  name: "openrouter",
  description: "OpenRouter — many models behind one OpenAI-compatible API",
  serves: [/.*/],
  baseUrl: "https://openrouter.ai/api/v1",
  apiKey: EnvironmentVariable.named("OPENROUTER_API_KEY", { secret: true }),
  timeout: minutes(2),
  // OpenRouter returns each call's cost
  cost: ModelCost.fromResponse(),
  reasoning: Reasoning.modelDecides(),
  promptCaching: PromptCaching.whereSupported({
    retention: CacheRetention.FiveMinutes,
    cachedParts: [CachedPart.SystemPrompt, CachedPart.Tools, CachedPart.History],
  }),
  retryPolicy: RetryPolicy.exponential({
    maxAttempts: 3,
    initialDelay: seconds(1),
    maxDelay: seconds(20),
    jitter: true,
    retryOn: TRANSIENT_FAILURES,
  }),
  circuitBreakerPolicy: { failureThreshold: 5, window: minutes(1), openFor: seconds(30) },
})
export class OpenRouterModelProvider extends OpenRouterProvider {
  // kimi-k2.6 via the provider Inceptron loops on tool-call arguments — let OpenRouter use the others
  override readonly requestFields: OpenRouterFields = { provider: { ignore: ["Inceptron"] } };
}
