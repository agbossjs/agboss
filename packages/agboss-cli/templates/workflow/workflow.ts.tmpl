import { Workflow, WorkflowSettings, route, start, type WorkflowDefinition } from "agboss";
import { WorkflowStartTextDto } from "agboss/dto";
import { usd } from "agboss/units";
import { TextWorkflowStart } from "./workflow-starts/text.workflow-start.js";
import { TextWorkflowFinish } from "./workflow-finishes/text.workflow-finish.js";
import { MainRouter } from "./routers/main.router.js";
{{imports}}

/** {{title}} — generated by `agboss create`; every setting below is yours to change. */
@Workflow({
  name: "{{kebab}}-workflow",
  version: "0.1.0",
  // the graph, one path: the text goes to the main router, which picks the agent that answers
  flow: [
    start(TextWorkflowStart)
      .returns(WorkflowStartTextDto)
      .toRouter(MainRouter)
      .chooseOne(
{{routes}}
      ),
  ],
  defaults: {
    // reasoning and caching: the model provider's (model-providers/, listed in the application),
    // an agent may override them
    models: { temperature: 0 },
    router: { model: "typesafe/jev-1.13" },
    guardrail: { model: "typesafe/jev-1.13" },
    tools: { maxToolCalls: 8 },
    history: { limit: 8 },
  },
  guards: {
    input: { prompt_injection: { threshold: 0.7, refusal: "I can't help with that request." } },
    output: { pii: { threshold: 0.7, refusal: "The answer contained personal data and was withheld." } },
  },
  mcp: [{{servers}}],
{{providers}}})
export class {{pascal}}Workflow implements WorkflowDefinition {
  settings(): WorkflowSettings {
    return WorkflowSettings.builder()
      .limits({ perRun: { cost: usd(0.1) }, perDay: { cost: usd(2) } })
      .build();
  }
}
