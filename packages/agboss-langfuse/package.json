{
  "name": "@agboss/langfuse",
  "version": "0.1.1",
  "description": "Langfuse tracing for AGBoss: LangfuseTracer, a TracingAdapter for createApp({ tracerProvider }) — the framework's OpenTelemetry spans, already masked by your PII policies, exported to (self-hosted) Langfuse, with a link to every execution.",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "author": "Pavel Ravvich <hello@agboss.dev> (https://github.com/pavelravvich)",
  "homepage": "https://agboss.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agbossjs/agboss.git",
    "directory": "packages/agboss-langfuse"
  },
  "bugs": {
    "url": "https://github.com/agbossjs/agboss/issues"
  },
  "keywords": [
    "agboss",
    "langfuse",
    "opentelemetry",
    "tracing",
    "observability",
    "ai-agents",
    "llm"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@langfuse/otel": "^5.11.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.211.0 <0.300.0",
    "@opentelemetry/otlp-exporter-base": ">=0.211.0 <0.300.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0"
  },
  "peerDependencies": {
    "@agboss/core": "^0.1.1",
    "@opentelemetry/api": "^1.9.0"
  }
}
