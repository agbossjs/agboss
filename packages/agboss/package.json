{
  "name": "agboss",
  "version": "0.1.0",
  "description": "Spring-style TypeScript framework for complex LangGraph AI agents — @Application DI, Path Scope Flow DSL, transactional sagas, FinOps budgets, MCP/RAG/A2A, and deterministic unit testing.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Pavel Ravvich <hello@agboss.dev> (https://github.com/pavelravvich)",
  "homepage": "https://agboss.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agbossjs/agboss.git",
    "directory": "packages/agboss"
  },
  "bugs": {
    "url": "https://github.com/agbossjs/agboss/issues"
  },
  "keywords": [
    "agboss",
    "langgraph",
    "langchain",
    "ai-agents",
    "agent-framework",
    "multi-agent",
    "typescript",
    "dependency-injection",
    "workflow",
    "saga",
    "mcp",
    "model-context-protocol",
    "rag",
    "a2a",
    "finops",
    "llm",
    "llm-evaluation",
    "guardrails",
    "pii",
    "nodejs"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "agboss": "./bin/agboss.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./dto": {
      "types": "./dist/dto/index.d.ts",
      "import": "./dist/dto/index.js"
    },
    "./units": {
      "types": "./dist/units/index.d.ts",
      "import": "./dist/units/index.js"
    },
    "./models": {
      "types": "./dist/models/index.d.ts",
      "import": "./dist/models/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./testing/setup": {
      "types": "./dist/testing/setup.d.ts",
      "import": "./dist/testing/setup.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./rag": {
      "types": "./dist/rag/index.d.ts",
      "import": "./dist/rag/index.js"
    },
    "./a2a": {
      "types": "./dist/a2a/index.d.ts",
      "import": "./dist/a2a/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
    },
    "./eval": {
      "types": "./dist/eval/index.d.ts",
      "import": "./dist/eval/index.js"
    },
    "./eslint": {
      "types": "./dist/eslint/index.d.ts",
      "import": "./dist/eslint/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./graph": {
      "types": "./dist/graph/index.d.ts",
      "import": "./dist/graph/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js"
    },
    "./tool": {
      "types": "./dist/tool/index.d.ts",
      "import": "./dist/tool/index.js"
    },
    "./channels": {
      "types": "./dist/channels/index.d.ts",
      "import": "./dist/channels/index.js"
    }
  },
  "deprecatedExports": {
    "./core": ".",
    "./graph": ".",
    "./router": ".",
    "./tool": ".",
    "./channels": "."
  },
  "internalExports": [
    "./internal"
  ],
  "files": [
    "bin",
    "dist",
    "schema",
    "skills",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "smoke": "vitest run --config vitest.smoke.config.ts",
    "schema": "tsx src/config/write-profile-schema.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.17",
    "@langchain/openai": "^1.5.13",
    "@langfuse/langchain": "^5.11.1",
    "@langfuse/otel": "^5.11.1",
    "@langfuse/tracing": "^5.11.1",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.211.0 <0.300.0",
    "@opentelemetry/otlp-exporter-base": ">=0.211.0 <0.300.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "tsx": "^4.19.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": ">=0.211.0 <0.300.0",
    "@opentelemetry/otlp-exporter-base": ">=0.211.0 <0.300.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@typescript-eslint/utils": "^8.0.0",
    "vitest": "^3.2.0"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/utils": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/server-filesystem": "^2026.8.31",
    "dotenv": "^18.0.3",
    "fast-check": "^3.23.2",
    "typescript": "^5.9.3"
  }
}
