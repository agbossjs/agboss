    "help-desk-router.toParallelAgents(order-lookup-agent, refund-policy-agent, loyalty-offer-agent)": readonly [LoyaltyOfferDto | undefined, OrderStatusDto, RefundPolicyDto | undefined];
    "offers-router.toParallelAgents(refund-policy-agent, loyalty-offer-agent)": readonly [LoyaltyOfferDto | undefined, RefundPolicyDto];
    "toParallelActions(send-receipt-action, update-crm-action, reserve-goods-action)": NoOutput;
    "toParallelAgents(company-audit-agent) per item": readonly CompanyCheckDto[];
    "toParallelAgents(company-vet-agent) per item": readonly CompanyCheckDto[];
    "toParallelAgents(item-blind-agent) per item": readonly CompanyCheckDto[];
    "toParallelAgents(legal-agent, deal-critic-agent, deal-critic-agent, auditor-agent, fast-screen-agent)": readonly [AuditDto, FastScreenDto, LegalReviewDto, readonly DealCritiqueDto[]];
    "toParallelAgents(legal-agent, deal-critic-agent, deal-critic-agent, auditor-agent, fast-screen-agent) group(auditor-agent)": AuditDto;
    "toParallelAgents(legal-agent, deal-critic-agent, deal-critic-agent, auditor-agent, fast-screen-agent) group(deal-critic-agent, deal-critic-agent)": readonly DealCritiqueDto[];
    "toParallelAgents(legal-agent, deal-critic-agent, deal-critic-agent, auditor-agent, fast-screen-agent) group(fast-screen-agent)": FastScreenDto;
    "toParallelAgents(legal-agent, deal-critic-agent, deal-critic-agent, auditor-agent, fast-screen-agent) group(legal-agent, deal-critic-agent)": readonly [LegalReviewDto, readonly DealCritiqueDto[]];
    "toParallelAgents(legal-panel-agent, critic-panel-agent, fast-panel-agent)": readonly [DealCritiqueDto, FastScreenDto, LegalReviewDto];
    "toParallelAgents(legal-panel-agent, critic-panel-agent, fast-panel-agent) group(critic-panel-agent)": DealCritiqueDto;
    "toParallelAgents(legal-panel-agent, critic-panel-agent, fast-panel-agent) group(fast-panel-agent)": FastScreenDto;
    "toParallelAgents(legal-panel-agent, critic-panel-agent, fast-panel-agent) group(legal-panel-agent, critic-panel-agent)": readonly [DealCritiqueDto, LegalReviewDto];
    "toParallelAgents(plan-researcher-agent, critic-agent, critic-agent)": readonly [readonly CritiqueDto[], ResearchDto];
    "toParallelAgents(score-a-agent, score-b-agent, score-c-agent)": readonly ScoreDto[];
    "toParallelAgents(skills-panel-agent, risks-panel-agent, hire-panel-agent)": readonly ScoreDto[];
    "toParallelAgents(skills-panel-agent, skills-panel-agent, skills-panel-agent)": readonly ScoreDto[];
    "toParallelAgents(skills-panel-agent) per item": readonly ScoreDto[];
    "toParallelAgents(skills-score-agent, culture-score-agent, salary-fit-agent)": readonly [CultureScoreDto, SalaryFitDto, SkillsScoreDto];
    "toParallelWorkflows(company-review-workflow) per item": readonly (CompanyGradeDto | CompanyRejectedDto | CompanyReviewFailedDto)[];
  }
  interface ThisWorkflowOutputs {
    "deep-research-workflow": { readonly input: NoInput; readonly output: ResearchFailedDto | ResearchReportDto; readonly join: readonly (ResearchFailedDto | ResearchReportDto)[] };
    "org-chart-workflow": { readonly input: NoInput; readonly output: OrgChartFailedDto | TeamChartDto; readonly join: readonly (OrgChartFailedDto | TeamChartDto)[] };
    "org-drill-workflow": { readonly input: NoInput; readonly output: OrgChartFailedDto | TeamChartDto };
    "org-retry-workflow": { readonly input: NoInput; readonly output: OrgChartFailedDto | TeamChartDto };
    "outline-workflow": { readonly input: NoInput; readonly output: ResearchFailedDto | ResearchReportDto };
  }
  interface ChannelRoles {
    "expense-approval-channel": { readonly ask: Omit<ToolCallApprovalAskDto, "arguments"> & { readonly arguments: ExpenseRequestDto }; readonly answer: Omit<ToolCallApprovalDecisionDto, "overrideArguments"> & { readonly overrideArguments?: ExpenseRequestDto } };
    "payout-approval-channel": { readonly ask: Omit<ToolCallApprovalAskDto, "arguments"> & { readonly arguments: PayoutRequestDto }; readonly answer: Omit<ToolCallApprovalDecisionDto, "overrideArguments"> & { readonly overrideArguments?: PayoutRequestDto } };
    "refund-approval-channel": { readonly ask: Omit<ToolCallApprovalAskDto, "arguments"> & { readonly arguments: RefundCardInputDto }; readonly answer: Omit<ToolCallApprovalDecisionDto, "overrideArguments"> & { readonly overrideArguments?: RefundCardInputDto } };
    "transfer-approval-channel": { readonly ask: Omit<ToolCallApprovalAskDto, "arguments"> & { readonly arguments: TransferRequestDto }; readonly answer: Omit<ToolCallApprovalDecisionDto, "overrideArguments"> & { readonly overrideArguments?: TransferRequestDto } };
  }
